  ]},
  {tag:"心动风景",title:"下面哪种风景最让你心动？",opts:[
    {t:"一望无际的海岸线和日落",s:{sy:2},d:{nature:2}},
    {t:"古城墙、红墙与飞檐",s:{xa:2,bj:1},d:{culture:2}},
    {t:"雪山倒映在湖里的干净画面",s:{dl:2},d:{nature:2}},
