<script>
"use strict";
/* =========================================================
   数据定义
   城市代号：cd=成都 xa=西安 sy=三亚 dl=大理 sh=上海 bj=北京
   维度：nature=自然风光 culture=历史人文 food=美食烟火
         city=都市活力 slow=慢节奏治愈
========================================================= */
var CITIES = {
  cd:{name:"成都",emoji:"🐼",tagline:"美食与慢生活的快乐老家",
      grad:"linear-gradient(135deg,#e8543f,#f07a4b)",
      tags:["美食之都","松弛感拉满","茶馆麻将","人均友好"],
      desc:"成都几乎是为国庆量身定做的城市：宽窄巷子的人民公园喝茶、奎星楼的串串冒菜、玉林路的深夜小酒馆，节奏慢到刚好治愈你。11 月前后天气微凉不晒，火锅正香。你不需要排满行程——睡醒吃、吃了逛、逛累喝茶，就是最正确的打开方式。",
      tips:[
        "提前 7-10 天订好酒店和热门火锅的等位，国庆成都人气极高",
