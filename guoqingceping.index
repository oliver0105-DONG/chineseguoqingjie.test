        "留一整天什么都不安排，咖啡馆发呆是大理的正确玩法"
      ]},
  sh:{name:"上海",emoji:"🌆",tagline:"都市摩登人的快乐星球",
      grad:"linear-gradient(135deg,#9b7ede,#bda6ef)",
      tags:["时尚都市","展览演出","夜生活","逛街购物"],
      desc:"国庆的上海是氛围感大师：武康路的梧桐树下挂满国旗、外滩江风配对岸灯光、安福路的街拍达人和全城不停歇的展览演出。白天逛美术馆买手冲咖啡，晚上钻进爵士酒吧或 livehouse，一座把\"精致\"刻进日常的城市，正适合活力满满的你。",
      tips:[
        "国庆外滩、武康路人流极大，清晨 7-9 点出片率最高",
        "提前预约想看的展览（西岸美术馆、UCCA Edge 等）",
        "避开人挤人：去浦东滨江、苏州河步道，夜景同样在线",
        "地铁+步行最方便，市区停车费贵且难找位",
        "留半天去朱家角或梧桐区 City Walk，感受城市另一面"
      ]},
  bj:{name:"北京",emoji:"🏮",tagline:"红墙金秋的仪式感之城",
      grad:"linear-gradient(135deg,#d4494f,#ef7a72)",
      tags:["国庆氛围","皇家园林","胡同漫步","文化大餐"],
      desc:"没有哪座城市比北京更有国庆氛围：满城红旗、天安门花坛、香山初染的红叶。上午在故宫红墙下拍照，中午胡同里来一顿涮肉，下午景山俯瞰整座中轴线。它厚重但不沉闷，热闹但讲规矩，适合想要仪式感和文化含量双高的旅行者。",
      tips:[
        "故宫、国家博物馆、天安门广场全部需要提前预约，务必抢票",
        "国庆当天核心区域管控严格，行程尽量避开 10 月 1 日上午",
        "香山、地坛、景山都是赏秋+氛围感双赢的选择",
        "胡同游推荐雍和宫-五道营-国子监一线，吃喝逛一体",
        "早晚温差大，备一件外套；烤鸭、涮肉认准老字号分店排队少"
      ]}
};

var DIMS = {
  nature:{name:"自然风光",color:"linear-gradient(90deg,#3fa796,#5cc9b8)"},
  culture:{name:"历史人文",color:"linear-gradient(90deg,#c05a3a,#e8964f)"},
  food:{name:"美食烟火",color:"linear-gradient(90deg,#e8543f,#f2b134)"},
  city:{name:"都市活力",color:"linear-gradient(90deg,#9b7ede,#bda6ef)"},
  slow:{name:"慢节奏治愈",color:"linear-gradient(90deg,#5b8def,#8fb1f5)"}
};

/* 每题选项：s=城市得分 d=维度得分 */
var QUESTIONS = [
