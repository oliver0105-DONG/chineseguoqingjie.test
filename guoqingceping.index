/* =========================================================
   状态与工具
========================================================= */
var answers = new Array(QUESTIONS.length).fill(null); // 存选项索引
var cur = 0;
var lastResult = null;
var advanceTimer = null; // 自动跳题定时器

var $ = function(id){ return document.getElementById(id); };
var screens = { home:$("screen-home"), quiz:$("screen-quiz"), result:$("screen-result") };

function show(name){
  Object.keys(screens).forEach(function(k){ screens[k].classList.remove("active"); });
  screens[name].classList.add("active");
  window.scrollTo({top:0,behavior:"smooth"});
}

var toastTimer = null;
function toast(msg){
  var t = $("toast");
  t.textContent = msg;
  t.classList.add("show");
  clearTimeout(toastTimer);
  toastTimer = setTimeout(function(){ t.classList.remove("show"); }, 1800);
}

/* =========================================================
   计分核心：由答案真实计算城市分 + 维度分
========================================================= */
function computeResult(){
  var cityScore = {}, dimScore = {};
  Object.keys(CITIES).forEach(function(k){ cityScore[k] = 0; });
  Object.keys(DIMS).forEach(function(k){ dimScore[k] = 0; });

  answers.forEach(function(optIdx, qIdx){
    if(optIdx === null) return;
    var opt = QUESTIONS[qIdx].opts[optIdx];
    var k;
    if(opt.s) for(k in opt.s) cityScore[k] += opt.s[k];
    if(opt.d) for(k in opt.d) dimScore[k] += opt.d[k];
  });

  // 找最高分城市（同分时按定义顺序取先者，保证结果可复现）
  var best = null, second = null;
  Object.keys(cityScore).forEach(function(k){
    if(best === null || cityScore[k] > cityScore[best]){ second = best; best = k; }
    else if(second === null || cityScore[k] > cityScore[second]){ second = k; }
  });

  var total = 0;
  Object.keys(cityScore).forEach(function(k){ total += cityScore[k]; });

  // 契合度：领先优势越大越高，范围约 60~95
  var top = cityScore[best], sec = cityScore[second] || 0;
  var match = Math.round(60 + (sec === 0 ? 1 : (top - sec) / top) * 35);

  // 维度占比
  var dimTotal = 0;
  Object.keys(dimScore).forEach(function(k){ dimTotal += dimScore[k]; });
  var dimPct = {};
  Object.keys(dimScore).forEach(function(k){
    dimPct[k] = dimTotal ? Math.round(dimScore[k] / dimTotal * 100) : 0;
  });

  return { cityScore:cityScore, dimScore:dimScore, dimPct:dimPct,
           best:best, second:second, match:match, total:total };
}

/* =========================================================
   答题页渲染
========================================================= */
function pad(n){ return n < 10 ? "0" + n : "" + n; }

function renderQuestion(goBack){
  var q = QUESTIONS[cur];
  var card = $("q-card");
  // 重触发进场动画
  card.classList.remove("back");
  card.style.animation = "none";
  void card.offsetWidth;
  card.style.animation = "";
  card.classList.toggle("back", !!goBack);

  $("q-now").textContent = cur + 1;
  $("q-tag").textContent = "QUESTION " + pad(cur + 1) + " · " + q.tag;
  $("q-title").textContent = q.title;

  var box = $("q-opts");
  box.innerHTML = "";
  q.opts.forEach(function(opt, i){
    var btn = document.createElement("button");
    btn.type = "button";
    btn.className = "opt" + (answers[cur] === i ? " selected" : "");
    btn.innerHTML = '<span class="radio"></span><span>' + opt.t + "</span>";
    btn.onclick = function(){
      clearTimeout(advanceTimer); // 防止快速连点导致连跳两题
      answers[cur] = i;
      // 保留选中态并自动进入下一题（最后一题除外）
      renderQuestion(false);
      if(cur < QUESTIONS.length - 1){
        advanceTimer = setTimeout(function(){ cur++; renderQuestion(false); updateProgress(); }, 160);
      }
    };
    box.appendChild(btn);
  });

  $("btn-prev").style.visibility = cur === 0 ? "hidden" : "visible";
  $("btn-next").textContent = (cur === QUESTIONS.length - 1) ? "✅ 提交并查看结果" : "下一题 →";
  updateProgress();
}

function updateProgress(){
  // 进度条 = 已作答题数 / 总题数（修改答案不影响进度，只影响得分）
  var done = answers.filter(function(a){ return a !== null; }).length;
  $("progress").style.width = Math.round(done / QUESTIONS.length * 100) + "%";
}

/* =========================================================
   结果页渲染
========================================================= */
function renderResult(r){
  lastResult = r;
  var c = CITIES[r.best];
  $("r-title").innerHTML = "你最适合去 <span style='color:" + "#e8543f" + "'>" + c.name + "</span>";
  $("t-emoji").textContent = c.emoji;
  $("t-city").textContent = c.name;
  $("t-tagline").textContent = c.tagline;
  $("t-match").textContent = "契合度 " + r.match + "%";
  $("t-top").style.background = c.grad;
  $("t-tags").innerHTML = c.tags.map(function(t){
    return '<span class="t-tagchip"># ' + t + "</span>";
  }).join("");
  $("t-desc").textContent = c.desc;

  // 维度条
  var dimsBox = $("r-dims");
  dimsBox.innerHTML = "";
  var sortedDims = Object.keys(r.dimPct).sort(function(a,b){ return r.dimPct[b] - r.dimPct[a]; });
  sortedDims.forEach(function(k){
    var row = document.createElement("div");
    row.className = "dim-row";
    row.innerHTML =
      '<div class="dim-head"><b>' + DIMS[k].name + "</b><span>" + r.dimPct[k] + "%</span></div>" +
      '<div class="dim-track"><div class="dim-fill" style="background:' + DIMS[k].color + '" data-w="' + r.dimPct[k] + '"></div></div>';
    dimsBox.appendChild(row);
  });
  // 动画填充
  setTimeout(function(){
    dimsBox.querySelectorAll(".dim-fill").forEach(function(el){
      el.style.width = el.getAttribute("data-w") + "%";
    });
  }, 350);

  var top2 = sortedDims.slice(0,2);
  $("r-dim-note").innerHTML = "你的旅行基因以 <b>" + DIMS[top2[0]].name + "</b> 和 <b>" +
    DIMS[top2[1]].name + "</b> 为主——这正是 " + c.name + " 最擅长提供的东西，所以它和你的气质一拍即合。";

  // 行动建议
  var tipsBox = $("r-tips");
  tipsBox.innerHTML = "";
  c.tips.forEach(function(t, i){
    var li = document.createElement("li");
    li.innerHTML = '<span class="no" style="background:' + c.grad + '">' + (i+1) + "</span><span>" + t + "</span>";
    tipsBox.appendChild(li);
  });

  // 次选 + 全部得分
  var secCity = CITIES[r.second];
  $("r-second").innerHTML =
    "<b>🥈 备选目的地：" + secCity.name + " " + secCity.emoji + "</b><br>" +
    "如果 " + c.name + " 的机票太贵或订不到房，" + secCity.name + "（" + secCity.tagline + "）也非常契合你的口味，可以放心作为 Plan B。";

  var rank = Object.keys(r.cityScore).sort(function(a,b){ return r.cityScore[b] - r.cityScore[a]; });
  var maxScore = r.cityScore[rank[0]] || 1;
  $("r-all").innerHTML = "<b>📊 各城市匹配得分（实时计算，非随机）</b><br>" +
    rank.map(function(k){
      var pct = Math.round(r.cityScore[k] / maxScore * 100);
      return CITIES[k].name + " " + CITIES[k].emoji +
        "：<b>" + r.cityScore[k] + " 分</b> " + bar(pct, CITIES[k].grad);
    }).join("<br>");

  function bar(p, color){
    return '<span style="display:inline-block;vertical-align:middle;width:110px;height:8px;background:#f3e7d7;border-radius:99px;overflow:hidden;margin-left:6px">' +
      '<span style="display:block;height:100%;width:' + p + '%;background:' + color + '"></span></span>';
  }
}

/* =========================================================
   事件绑定
========================================================= */
$("btn-start").onclick = function(){
  cur = 0;
  answers = new Array(QUESTIONS.length).fill(null);
  show("quiz");
  renderQuestion(false);
};

$("btn-quit").onclick = function(){
  show("home");
};

$("btn-prev").onclick = function(){
  if(cur > 0){ cur--; renderQuestion(true); }
};

$("btn-next").onclick = function(){
  if(answers[cur] === null){
    toast(cur === QUESTIONS.length - 1 ? "请先选择一个答案再提交哦" : "这题还没选哦，选一个再继续～");
    var card = $("q-card");
    card.classList.remove("shake");
    void card.offsetWidth;
    card.classList.add("shake");
    return;
  }
  if(cur < QUESTIONS.length - 1){
    cur++;
    renderQuestion(false);
  }else{
    // 最终提交：全部已答校验
    var unanswered = answers.findIndex(function(a){ return a === null; });
    if(unanswered !== -1){
      cur = unanswered;
      renderQuestion(false);
      toast("还有第 " + (unanswered + 1) + " 题没答，帮你跳过去了");
      return;
    }
    renderResult(computeResult());
    show("result");
  }
};

$("btn-retry").onclick = function(){
  cur = 0;
  answers = new Array(QUESTIONS.length).fill(null);
  show("home");
};

$("btn-share").onclick = function(){
  if(!lastResult) return;
  var c = CITIES[lastResult.best];
  var text = "【国庆目的地测评】我是 " + c.name + c.emoji + "（契合度 " + lastResult.match + "%，" + c.tagline + "），你也来测测吧！";
  var done = function(ok){ toast(ok ? "结果已复制，去粘贴分享吧～" : "复制失败，请手动截图分享"); };
  if(navigator.clipboard && navigator.clipboard.writeText){
    navigator.clipboard.writeText(text).then(function(){ done(true); }, function(){ done(false); });
  }else{
    var ta = document.createElement("textarea");
    ta.value = text; document.body.appendChild(ta); ta.select();
    var ok = false;
    try{ ok = document.execCommand("copy"); }catch(e){ ok = false; }
    document.body.removeChild(ta);
    done(ok);
  }
};
</script>


</body></html>